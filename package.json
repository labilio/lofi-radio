{
  "name": "lofi-radio-player",
  "version": "1.3.0",
  "description": "Lofi Radio Player",
  "main": "src/main/index.js",
  "homepage": "./",
  "scripts": {
    "test": "node --test test/*.test.js",
    "benchmark:stations": "node scripts/station-network-benchmark.js",
    "start": "electron . --disable-dev-tools",
    "dev": "electron .",
    "debug": "electron . --enable-logging --log-level=0",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "dist": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never"
  },
  "keywords": [
    "electron",
    "music-player",
    "lofi",
    "bilibili"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "40.8.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lofi-radio-player.app",
    "productName": "Lofi Radio Player",
    "electronLanguages": [
      "zh-CN",
      "en"
    ],
    "directories": {
      "output": "dist_green"
    },
    "files": [
      "package.json",
      "LICENSE",
      "src/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/@awesome.me/webawesome/**/*"
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "labilio",
        "repo": "lofi-radio"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "identity": "-",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lofi Radio Player"
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.10.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "hls.js": "1.6.16"
  }
}
